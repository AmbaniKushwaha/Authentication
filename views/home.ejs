
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Home | MyApp</title>

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: "Inter", Arial, sans-serif;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      min-height: 100vh;
      color: #fff;
      background: #0f172a;
      overflow-x: hidden;
    }

    /* =========================
       Animated Background
    ========================= */

    .background {
      position: fixed;
      inset: 0;
      overflow: hidden;
      z-index: -1;
      background:
        radial-gradient(
          circle at top left,
          #312e81 0,
          transparent 35%
        ),
        radial-gradient(
          circle at bottom right,
          #164e63 0,
          transparent 35%
        ),
        #0f172a;
    }

    .blob {
      position: absolute;
      width: 350px;
      height: 350px;
      border-radius: 50%;
      filter: blur(100px);
      opacity: .35;
      animation: float 10s ease-in-out infinite alternate;
    }

    .blob:nth-child(1) {
      background: #8b5cf6;
      top: -150px;
      left: -100px;
    }

    .blob:nth-child(2) {
      background: #06b6d4;
      right: -120px;
      bottom: -150px;
      animation-delay: 2s;
    }

    .blob:nth-child(3) {
      background: #ec4899;
      width: 220px;
      height: 220px;
      top: 45%;
      left: 45%;
      animation-delay: 4s;
    }

    @keyframes float {
      from {
        transform: translate(0, 0) scale(1);
      }

      to {
        transform: translate(60px, -50px) scale(1.15);
      }
    }

    /* =========================
       Navbar
    ========================= */

    .navbar {
      width: 100%;
      padding: 18px 7%;

      display: flex;
      align-items: center;
      justify-content: space-between;

      position: fixed;
      top: 0;
      left: 0;
      z-index: 100;

      background: rgba(15, 23, 42, .55);
      border-bottom: 1px solid rgba(255,255,255,.08);

      backdrop-filter: blur(18px);
      -webkit-backdrop-filter: blur(18px);
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 10px;

      font-size: 21px;
      font-weight: 800;
      color: #fff;
      text-decoration: none;
    }

    .brand-logo {
      width: 40px;
      height: 40px;

      display: flex;
      align-items: center;
      justify-content: center;

      border-radius: 12px;

      background: linear-gradient(
        135deg,
        #8b5cf6,
        #06b6d4
      );

      box-shadow:
        0 8px 25px rgba(139,92,246,.3);
    }

    .nav-links {
      display: flex;
      align-items: center;
      gap: 30px;
    }

    .nav-links a {
      color: #cbd5e1;
      text-decoration: none;
      font-size: 14px;
      transition: .25s;
    }

    .nav-links a:hover {
      color: #fff;
    }

    .nav-buttons {
      display: flex;
      gap: 10px;
      align-items: center;
    }

    .btn {
      padding: 10px 18px;
      border-radius: 10px;

      text-decoration: none;
      font-size: 14px;
      font-weight: 600;

      transition: .3s;
    }

    .btn-login {
      color: #e2e8f0;
      border: 1px solid rgba(255,255,255,.15);
      background: rgba(255,255,255,.05);
    }

    .btn-login:hover {
      background: rgba(255,255,255,.1);
    }

    .btn-signup {
      color: #fff;

      background: linear-gradient(
        135deg,
        #8b5cf6,
        #06b6d4
      );

      box-shadow:
        0 8px 25px rgba(139,92,246,.25);
    }

    .btn-signup:hover {
      transform: translateY(-2px);
      box-shadow:
        0 12px 30px rgba(139,92,246,.4);
    }

    /* =========================
       Hero
    ========================= */

    .hero {
      min-height: 100vh;

      display: flex;
      align-items: center;
      justify-content: center;

      text-align: center;

      padding: 130px 20px 80px;
    }

    .hero-content {
      max-width: 850px;

      animation: heroEnter 1s ease forwards;
    }

    @keyframes heroEnter {
      from {
        opacity: 0;
        transform: translateY(40px);
      }

      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;

      padding: 8px 15px;

      margin-bottom: 25px;

      border-radius: 50px;

      color: #c4b5fd;

      background: rgba(139,92,246,.12);
      border: 1px solid rgba(139,92,246,.25);

      font-size: 13px;
    }

    .badge span {
      width: 7px;
      height: 7px;

      border-radius: 50%;
      background: #22c55e;

      box-shadow:
        0 0 10px #22c55e;
    }

    .hero h1 {
      font-size: clamp(42px, 7vw, 78px);
      line-height: 1.05;

      letter-spacing: -3px;

      margin-bottom: 25px;
    }

    .gradient-text {
      background: linear-gradient(
        90deg,
        #a78bfa,
        #22d3ee,
        #f0abfc
      );

      -webkit-background-clip: text;
      background-clip: text;

      color: transparent;

      background-size: 200% auto;

      animation: gradientMove 4s linear infinite;
    }

    @keyframes gradientMove {
      to {
        background-position: 200% center;
      }
    }

    .hero p {
      max-width: 650px;
      margin: auto;

      color: #94a3b8;

      font-size: 17px;
      line-height: 1.7;
    }

    .hero-buttons {
      display: flex;
      justify-content: center;
      gap: 15px;

      margin-top: 35px;
    }

    .hero-btn {
      padding: 14px 25px;

      border-radius: 12px;

      font-size: 15px;
      font-weight: 700;

      text-decoration: none;

      transition: .3s;
    }

    .primary {
      color: #fff;

      background: linear-gradient(
        135deg,
        #8b5cf6,
        #06b6d4
      );

      box-shadow:
        0 12px 35px rgba(139,92,246,.3);
    }

    .primary:hover {
      transform: translateY(-3px);
      box-shadow:
        0 18px 40px rgba(139,92,246,.45);
    }

    .secondary {
      color: #e2e8f0;

      background: rgba(255,255,255,.06);

      border: 1px solid rgba(255,255,255,.15);
    }

    .secondary:hover {
      background: rgba(255,255,255,.1);
      transform: translateY(-3px);
    }

    /* =========================
       Features
    ========================= */

    .features {
      max-width: 1150px;

      margin: 0 auto;

      padding: 80px 25px 110px;
    }

    .section-title {
      text-align: center;
      margin-bottom: 50px;
    }

    .section-title h2 {
      font-size: 38px;
      margin-bottom: 12px;
    }

    .section-title p {
      color: #94a3b8;
    }

    .feature-grid {
      display: grid;

      grid-template-columns:
        repeat(3, 1fr);

      gap: 20px;
    }

    .feature-card {
      padding: 30px;

      border-radius: 20px;

      background: rgba(255,255,255,.06);

      border: 1px solid rgba(255,255,255,.1);

      backdrop-filter: blur(15px);

      transition: .35s;

      animation: cardUp .8s ease both;
    }

    .feature-card:nth-child(2) {
      animation-delay: .15s;
    }

    .feature-card:nth-child(3) {
      animation-delay: .3s;
    }

    @keyframes cardUp {
      from {
        opacity: 0;
        transform: translateY(30px);
      }

      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .feature-card:hover {
      transform: translateY(-8px);

      border-color: rgba(139,92,246,.4);

      background: rgba(255,255,255,.09);

      box-shadow:
        0 20px 50px rgba(0,0,0,.2);
    }

    .feature-icon {
      width: 52px;
      height: 52px;

      display: flex;
      align-items: center;
      justify-content: center;

      margin-bottom: 20px;

      border-radius: 14px;

      font-size: 23px;

      background:
        linear-gradient(
          135deg,
          rgba(139,92,246,.2),
          rgba(6,182,212,.2)
        );
    }

    .feature-card h3 {
      font-size: 19px;
      margin-bottom: 10px;
    }

    .feature-card p {
      color: #94a3b8;
      line-height: 1.6;
      font-size: 14px;
    }

    /* =========================
       CTA
    ========================= */

    .cta {
      max-width: 1000px;

      margin: 0 auto 100px;

      padding: 55px 30px;

      text-align: center;

      border-radius: 25px;

      background:
        linear-gradient(
          135deg,
          rgba(139,92,246,.15),
          rgba(6,182,212,.1)
        );

      border: 1px solid rgba(255,255,255,.12);

      box-shadow:
        0 25px 70px rgba(0,0,0,.2);
    }

    .cta h2 {
      font-size: 35px;
      margin-bottom: 12px;
    }

    .cta p {
      color: #94a3b8;
      margin-bottom: 25px;
    }

    /* =========================
       Footer
    ========================= */

    footer {
      padding: 30px 7%;

      border-top: 1px solid rgba(255,255,255,.08);

      display: flex;
      justify-content: space-between;
      align-items: center;

      color: #64748b;

      font-size: 13px;
    }

    footer a {
      color: #94a3b8;
      text-decoration: none;
      margin-left: 20px;
    }

    footer a:hover {
      color: #fff;
    }

    /* =========================
       Responsive
    ========================= */

    @media (max-width: 800px) {

      .nav-links {
        display: none;
      }

      .feature-grid {
        grid-template-columns: 1fr;
      }

      .hero h1 {
        letter-spacing: -2px;
      }
    }

    @media (max-width: 500px) {

      .navbar {
        padding: 15px 20px;
      }

      .btn {
        padding: 9px 12px;
      }

      .hero {
        padding-top: 120px;
      }

      .hero-buttons {
        flex-direction: column;
      }

      .hero-btn {
        width: 100%;
      }

      .cta h2 {
        font-size: 28px;
      }

      footer {
        flex-direction: column;
        gap: 15px;
        text-align: center;
      }

      footer a {
        margin: 0 8px;
      }
    }
  </style>
</head>

<body>

  <!-- Background -->
  <div class="background">
    <div class="blob"></div>
    <div class="blob"></div>
    <div class="blob"></div>
  </div>

  <!-- Navbar -->
  <nav class="navbar">

    <a href="/" class="brand">
      <span class="brand-logo">S</span>
      MyApp
    </a>

    <div class="nav-links">
      <a href="/">Home</a>
      <a href="#features">Features</a>
      <a href="#about">About</a>
    </div>

    <div class="nav-buttons">
      <a href="/login" class="btn btn-login">
        Login
      </a>

      <a href="/signup" class="btn btn-signup">
        Get Started
      </a>
    </div>

  </nav>


  <!-- Hero -->
  <main>

    <section class="hero">

      <div class="hero-content">

        <div class="badge">
          <span></span>
          Everything is ready for you
        </div>

        <h1>
          Build your
          <span class="gradient-text">
            digital experience.
          </span>
        </h1>

        <p>
          A modern platform designed to help you manage your
          account, access your information, and get more done
          from one beautiful dashboard.
        </p>

        <div class="hero-buttons">

          <a
            href="/signup"
            class="hero-btn primary"
          >
            Create Free Account →
          </a>

          <a
            href="#features"
            class="hero-btn secondary"
          >
            Explore Features
          </a>

        </div>

      </div>

    </section>


    <!-- Features -->
    <section
      class="features"
      id="features"
    >

      <div class="section-title">

        <h2>Everything you need</h2>

        <p>
          Simple, powerful and designed for modern users.
        </p>

      </div>

      <div class="feature-grid">

        <div class="feature-card">

          <div class="feature-icon">
            👤
          </div>

          <h3>Personal Profile</h3>

          <p>
            Manage your personal information and keep
            your profile updated from one convenient place.
          </p>

        </div>


        <div class="feature-card">

          <div class="feature-icon">
            ⚡
          </div>

          <h3>Fast & Simple</h3>

          <p>
            Enjoy a clean and responsive experience
            designed to help you find what you need quickly.
          </p>

        </div>


        <div class="feature-card">

          <div class="feature-icon">
            🔒
          </div>

          <h3>Secure Account</h3>

          <p>
            Your account information is protected with
            modern authentication and security practices.
          </p>

        </div>

      </div>

    </section>


    <!-- CTA -->
    <section
      class="cta"
      id="about"
    >

      <h2>Ready to get started?</h2>

      <p>
        Create your account and explore your personalized
        experience today.
      </p>

      <a
        href="/signup"
        class="hero-btn primary"
      >
        Create Your Account
      </a>

    </section>

  </main>


  <!-- Footer -->
  <footer>

    <div>
      © <%= new Date().getFullYear() %> MyApp. All rights reserved.
    </div>

    <div>
      <a href="/privacy">Privacy</a>
      <a href="/terms">Terms</a>
      <a href="/contact">Contact</a>
    </div>

  </footer>

</body>
</html>
